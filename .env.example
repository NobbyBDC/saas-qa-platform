# =============================================================================
# SAAS QA PLATFORM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# ── API Gateway ───────────────────────────────────────────────────────────────
API_GATEWAY_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_USER=qaplatform
POSTGRES_PASSWORD=qaplatform_pass
POSTGRES_DB=qaplatform
DATABASE_URL=postgresql://qaplatform:qaplatform_pass@localhost:5432/qaplatform

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# ── Object Storage (MinIO locally / S3 in production) ─────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
S3_BUCKET_REPORTS=qa-platform-reports
# Production S3:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Stripe Billing ────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Create products in Stripe dashboard, paste price IDs here:
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_ENTERPRISE=price_enterprise_placeholder

# ── Anthropic AI Copilot ──────────────────────────────────────────────────────
# Get key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── GitHub Integration ────────────────────────────────────────────────────────
# Create OAuth App at https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/github/oauth/callback
GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# For local dev, use Mailhog (included in docker-compose): http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@qaplatform.io
# Production SendGrid example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key

# ── Slack Notifications ───────────────────────────────────────────────────────
# Incoming webhook URL from https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# LOG_FILE=/var/log/qa-platform/api.log

# ── Internal service URLs ─────────────────────────────────────────────────────
FIGMA_SERVICE_URL=http://localhost:4001
CODEGEN_SERVICE_URL=http://localhost:4002
TESTING_SERVICE_URL=http://localhost:4003
SECURITY_SERVICE_URL=http://localhost:4004
REPORTING_SERVICE_URL=http://localhost:4005

# ── Figma API ─────────────────────────────────────────────────────────────────
FIGMA_WEBHOOK_SECRET=change-me-figma-webhook-secret

# ── AWS (Production only) ─────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ECR_REGISTRY=123456789.dkr.ecr.us-east-1.amazonaws.com
# CLOUDFRONT_DISTRIBUTION_ID=

# ── Legacy OpenAI (kept for any services still using it) ──────────────────────
# OPENAI_API_KEY=sk-
